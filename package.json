{
  "name": "@halifage/mobile-money",
  "version": "0.3.1",
  "description": "Mobile money collections and payouts for Cameroon: Orange and MTN direct, pawaPay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halifage/mobile-money.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc",
    "lint": "biome check .",
    "smoke": "npm run build && node test/package-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "25.6.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
