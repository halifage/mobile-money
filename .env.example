# Copy to .env.live for scripts/live-orange.mjs. Never commit real values.
# Orange Money Cameroon local API credentials (from the merchant account)
ORANGE_USERNAME=
ORANGE_PASSWORD=
ORANGE_AUTH_TOKEN=
ORANGE_MERCHANT_MSISDN=
ORANGE_PIN=

# Orange Web Payment (api.orange.com) for scripts/live-orange-webpay.mjs: developer.orange.com app + merchant key
ORANGE_WEBPAY_CLIENT_ID=
ORANGE_WEBPAY_CLIENT_SECRET=
ORANGE_WEBPAY_MERCHANT_KEY=
# dev = sandbox (test currency OUV), cm = Cameroon production (real money)
ORANGE_WEBPAY_ENVIRONMENT=dev
